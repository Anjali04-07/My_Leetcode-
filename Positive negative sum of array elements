import java.util.Arrays;
class ArrayBasicProblem {
         static int[] getPosNegSum(int[] arr) {
        int posSum = 0;
        int negSum = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] > 0) {
                posSum += arr[i];
            } else {
                negSum += arr[i];
            }
        }
        int[] ansArr = {posSum, negSum};
        return ansArr;
    }
    public static void main(String[] args) {

        int arr[] = {10, 20, -4, 6, -8, -3, 7};

        int[] result = getPosNegSum(arr);

        System.out.println("Positive Sum = " + result[0]);
        System.out.println("Negative Sum = " + result[1]);

        // Or print the complete array:
        System.out.println(Arrays.toString(result));
    }
}

    
