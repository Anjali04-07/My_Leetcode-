class Solution {
   public static int countPrimes(int n) {

    boolean[] isPrime = new boolean[n + 1];

    // Initially mark all numbers as prime
    for (int i = 2; i <= n; i++) {
        isPrime[i] = true;
    }

    int count = 0;

    for (int i = 2; i < n; i++) {

        if (isPrime[i]) {
            count++;

            for (int j = i * 2; j < n; j = j + i) {
                isPrime[j] = false;
            }
        }
    }

    return count;
}
}
