public class BasicMaths{
    static boolean isPrime(int num)
    {
     for(int i=2;i<num-1;i++){
        if(num%i==0){
            return false;
        }
     }
     return true; 
    }

    public static void main(String args[]){
        int num=78;
        boolean result=isPrime(num);
        System.out.println(result);
    }
}
