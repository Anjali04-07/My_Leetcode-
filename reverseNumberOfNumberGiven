public class BasicMaths{
    static int reverseNum(int num)
    {
    int ans=0;
    while(num!=0){
        int digit=num%10;
        ans=ans*10+digit;
        num=num/10;
    }
    return ans;
    }
    public static void main(String args[]){
        int num=98563;
        int result=reverseNum(num);
        System.out.println(result);
    }
}
