public class BasicMaths{
    static int sumofdigit(int num){
        int sum=0;
        while(num!=0){
            int digit=num%10;
            sum+=digit;
            num=num/10;
        }
        return sum;
    }
    public static void main(String args[]){
        int num=45;
        int result=sumofdigit(num);
        System.out.println(result);
    }
}
