class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int sum=0;

        for(int i=0; i<k; i++)
        sum+=nums[i];

        int max=sum;
        int S=0;
        int E=k;

        while(E<nums.length){

            sum=sum-nums[S];
            S++;

            sum=sum+nums[E];
            E++;

            max=Math.max(max,sum);
        }
        return (double) max/k;
    }
}
