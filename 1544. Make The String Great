
class Solution {
    public String makeGood(String s) {
        String result = "";

        for (char ch : s.toCharArray()) {
            int n = result.length();

            if (n > 0 && Math.abs(result.charAt(n - 1) - ch) == 32) {
                result = result.substring(0, n - 1);
            } else {
                result += ch;
            }
        }

        return result;
    }
}
