class Solution {
    public boolean canThreePartsEqualSum(int[] arr) {
      int totalsum=0;
      int n = arr.length;
      for(int i=0;i<n;i++){
        totalsum+=arr[i];
      }  
      if(totalsum %3 != 0){
        return false;
      }

      int target=totalsum/3;
      int currsum=0;
      int part= 0;

      for(int i=0;i<n;i++){

        currsum+=arr[i];

        if(currsum==target){
            part++;
            currsum=0;
        }
      }
      return part>=3;
    }
}
