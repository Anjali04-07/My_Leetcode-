class ArrayBasicProblem {

    static double getAverage(int[] arr) {
        double sum = 0;
        int size = arr.length;
        for(int i:arr){
            sum+=i;
        }
        double avg=sum/size;
        return avg;      
    }
    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5,6 ,7 ,8 ,9};
        double average = getAverage(arr);
        System.out.println("Average: " + average);
    }
}
