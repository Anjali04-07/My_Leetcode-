     static int countdigit(int num){
     int count=0;
     while(num!=0){
        int digit=num%10;
        count++;
        num=num/10;
     }
     return count;
    }
    public static void main(String args[]){
        int num=435678;
        int result=countdigit(num);
        System.out.println("The number of digits in the given number is: "+result);
    }
