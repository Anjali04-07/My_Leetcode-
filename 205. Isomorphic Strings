import java.util.HashMap;

class Solution {
    public boolean isIsomorphic(String s, String t) {
        
        if (s.length() != t.length()) {
            return false;
        }

        HashMap<Character, Character> mp1 = new HashMap<>();
        HashMap<Character, Boolean> mp2 = new HashMap<>();

        int n = s.length();

        for (int i = 0; i < n; i++) {
            char ch1 = s.charAt(i);
            char ch2 = t.charAt(i);

            // If ch1 is already mapped
            if (mp1.containsKey(ch1)) {
                if (mp1.get(ch1) != ch2) {
                    return false;
                }
            } 
            else {
                // ch1 is not mapped, but ch2 is already used
                if (mp2.containsKey(ch2)) {
                    return false;
                }

                // Create the mapping
                mp1.put(ch1, ch2);
                mp2.put(ch2, true);
            }
        }

        return true;
    }
}
