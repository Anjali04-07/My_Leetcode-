class BasicMaths{
    static boolean checkFactorNumber(int num){
        int sum=0;
        for(int i=2;i*i<num;i++){
            if(num%i==0){
                int f1=i;
                int f2=num/i;
                sum+=f1+f2;
            }
        }
        if(sum==num){
            return true;
        }
        else{
            return false;
        }
    }
    public static void main(String args[]){
        int num=12;
        boolean result=checkFactorNumber(num);
        System.out.println(result);
    }
}
