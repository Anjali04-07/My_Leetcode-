import java.util.*;

class Solution {
    public int[] finalPrices(int[] prices) {
        int n = prices.length;
        int[] answer = new int[n];
        Stack<Integer> stack = new Stack<>();

        for (int i = 0; i < n; i++) {

            // Check if current price can be discount for previous items
            while (!stack.isEmpty() && prices[stack.peek()] >= prices[i]) {
                int index = stack.pop();
                answer[index] = prices[index] - prices[i];
            }

            stack.push(i);
        }

        // For remaining items with no discount
        while (!stack.isEmpty()) {
            int index = stack.pop();
            answer[index] = prices[index];
        }

        return answer;
    }
}
